{
  "redirects": [
    {
      "source": "/sitemap.xml",
      "destination": "/fuja/",
      "permanent": false
    },
    {
      "source": "/sitemap_index.xml",
      "destination": "/fuja/",
      "permanent": false
    },
    {
      "source": "/sitemap(.*).xml",
      "destination": "/fuja/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fuja/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/membros/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "membros.vesprowallpapers.com"
        }
      ],
      "destination": "/membros/index.html"
    }
  ]
}
